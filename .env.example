# Copy to .env and fill in.

# Free key: https://openrouteservice.org/dev/#/signup  (required: plans the walking route)
ORS_API_KEY=

# Free token: https://www.mapillary.com/dashboard/developers  (optional: street-level photos;
# falls back to Wikimedia Commons without it)
MAPILLARY_TOKEN=

# Wikipedia language for trivia (en, fr, ...)
WIKI_LANG=en

# Contact sent in the User-Agent to Nominatim/Overpass, as their usage policies ask (optional)
ORIENTER_CONTACT=

# Where the SQLite db and Garmin tokens live (default: ./data)
# ORIENTER_DATA_DIR=
